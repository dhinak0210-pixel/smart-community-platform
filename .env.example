# ═══════════════════════════════════════
# SMART COMMUNITY PLATFORM - ENVIRONMENT
# ═══════════════════════════════════════
# Copy this file to .env
# Fill in your real values
# NEVER commit .env to git

# ───────────────────────────────────────
# DATABASE (Required)
# ───────────────────────────────────────
# Get from: neon.tech → your project → connection string
# Must include ?sslmode=require for Neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# ───────────────────────────────────────
# SECURITY (Required)
# ───────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Must be at least 32 characters long
# NEVER use the example value in production
SECRET_KEY=CHANGE-THIS-TO-RANDOM-64-CHAR-STRING-NEVER-USE-DEFAULT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ───────────────────────────────────────
# CLOUDINARY (Required for image uploads)
# ───────────────────────────────────────
# Get from: cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_api_secret_here

# ───────────────────────────────────────
# EMAIL (Required for notifications)
# ───────────────────────────────────────
# Use Gmail App Password (not your regular password)
# Create at: myaccount.google.com → Security → App passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=xxxx_xxxx_xxxx_xxxx
EMAIL_FROM=noreply@smartcommunity.com
EMAIL_FROM_NAME=Smart Community Platform

# ───────────────────────────────────────
# AI - GROQ (Required for LLM features)
# ───────────────────────────────────────
# Get free API key at: console.groq.com
GROQ_API_KEY=gsk_your_groq_key_here

# ───────────────────────────────────────
# APPLICATION SETTINGS
# ───────────────────────────────────────
# Set to your actual frontend URL after deploying
FRONTEND_URL=http://localhost:3000

# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set to false in production
DEBUG=true

# Options: development, production, testing
ENVIRONMENT=development

# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ───────────────────────────────────────
# ML MODEL SETTINGS
# ───────────────────────────────────────
# Directory where ML models are cached locally
HUGGINGFACE_MODEL_CACHE_DIR=./ml_models
YOLO_MODEL_PATH=./ml_models/yolov8n.pt

# Minimum confidence to use ML result (0.0 to 1.0)
ML_CONFIDENCE_THRESHOLD=0.75

# Minimum confidence to AUTO-APPLY ML result to DB
ML_AUTO_APPLY_THRESHOLD=0.85

# Use cpu for everyone without GPU
ML_DEVICE=cpu

# Reduce for lower RAM usage
ML_BATCH_SIZE=4

# ───────────────────────────────────────
# UPLOAD SETTINGS
# ───────────────────────────────────────
MAX_IMAGE_SIZE_MB=5
MAX_IMAGES_PER_ISSUE=5
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp

# ───────────────────────────────────────
# AGENT SETTINGS
# ───────────────────────────────────────
# How often the Reporter Agent runs (minutes)
AGENT_REPORTER_INTERVAL_MINUTES=5

# How often the Resolver Agent runs (hours)
AGENT_RESOLVER_INTERVAL_HOURS=6

# Analyst Agent: day of week (0=Monday, 6=Sunday)
AGENT_ANALYST_DAY_OF_WEEK=6

# Analyst Agent: hour to run (24h format UTC)
AGENT_ANALYST_HOUR=2

# How often Volunteer Agent runs (hours)
AGENT_VOLUNTEER_INTERVAL_HOURS=1

# Max retries for failed agent operations
AGENT_MAX_RETRIES=3

# Days before escalating in-progress issues
AGENT_ESCALATION_DAYS=7

# Days before auto-closing pending_citizen issues
AGENT_AUTO_CLOSE_DAYS=7

# Minimum score for volunteer matching (0.0 to 1.0)
AGENT_MIN_VOLUNTEER_MATCH_SCORE=0.6

# System user ID for agent database actions
SYSTEM_USER_ID=1
