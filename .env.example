# ==============================================================================
# SMART COMMUNITY PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual credentials before running.
# NEVER commit .env to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# APP CONFIGURATION (Required)
# ------------------------------------------------------------------------------
APP_NAME="Smart Community Platform"
APP_ENV="development"              # development | staging | production
DEBUG=True                          # Set False in production
HOST="0.0.0.0"                      # Bind host
PORT=8000                           # Server port
CORS_ORIGINS="http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000"

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (Required)
# PostgreSQL Connection URL (Neon.tech or local PostgreSQL instance)
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_community"

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY (Required)
# Generate a strong key in bash using: openssl rand -hex 32
# ------------------------------------------------------------------------------
SECRET_KEY="replace_with_a_super_secret_64_character_hex_string_for_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# CLOUDINARY MEDIA STORAGE (Optional - Local file fallback used if empty)
# Get credentials at https://cloudinary.com/
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ------------------------------------------------------------------------------
# EMAIL NOTIFICATION SERVICES (Optional - Logged to console if disabled)
# SMTP details for automated email notifications
# ------------------------------------------------------------------------------
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_FROM="noreply@smartcommunity.org"
MAIL_PORT=587
MAIL_SERVER="smtp.gmail.com"
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

# ------------------------------------------------------------------------------
# AI & EXTERNAL SERVICES (Phase 2/3 - Optional)
# Free API Key from https://console.groq.com/
# ------------------------------------------------------------------------------
GROQ_API_KEY=""
