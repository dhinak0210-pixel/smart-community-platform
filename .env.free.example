# ═════════════════════════════════════════════════════════════════
# SMART COMMUNITY PLATFORM - 100% FREE TIER CONFIGURATION
# Zero dollars. No credit card required. Free forever.
# ═════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────
# DATABASE - Neon.tech (FREE FOREVER)
# Get at: https://neon.tech -> Create Project -> Copy Connection String
# Format: postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
# ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# ─────────────────────────────────────────────────────────────────
# SECURITY
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
# ─────────────────────────────────────────────────────────────────
SECRET_KEY=generate_a_random_32_character_hex_string_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─────────────────────────────────────────────────────────────────
# IMAGE STORAGE - Cloudinary (FREE: 25GB Storage & Bandwidth)
# Get at: https://cloudinary.com -> Console Dashboard
# ─────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# ─────────────────────────────────────────────────────────────────
# EMAIL - Resend API (FREE: 3,000 emails/month)
# Get at: https://resend.com -> API Keys -> Create Key
# ─────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=noreply@smartcommunity.app
EMAIL_FROM_NAME=Smart Community Platform

# OPTIONAL GMAIL SMTP BACKUP (FREE: 500 emails/day)
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# ─────────────────────────────────────────────────────────────────
# AI / LLM INFERENCE - Groq API (FREE: 100,000 tokens/day)
# Get at: https://console.groq.com -> API Keys
# ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here

# ─────────────────────────────────────────────────────────────────
# HUGGING FACE INFERENCE API (FREE Zero-Shot Classification)
# Get at: https://huggingface.co -> Settings -> Access Tokens
# ─────────────────────────────────────────────────────────────────
HUGGINGFACE_API_KEY=hf_your_huggingface_token_here

# ─────────────────────────────────────────────────────────────────
# APPLICATION & CORS SETTINGS
# Set FRONTEND_URL to your Vercel URL (e.g. https://smart-community.vercel.app)
# ─────────────────────────────────────────────────────────────────
FRONTEND_URL=https://smart-community.vercel.app
CORS_ORIGINS=https://smart-community.vercel.app,http://localhost:3000
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────────
# ML RUNTIME SETTINGS (Lightweight for 512MB RAM free tier)
# ─────────────────────────────────────────────────────────────────
ML_MODE=lightweight
ML_DEVICE=cpu
ML_CONFIDENCE_THRESHOLD=0.75
ML_AUTO_APPLY_THRESHOLD=0.85
HUGGINGFACE_MODEL_CACHE_DIR=/opt/render/project/ml_models

# ─────────────────────────────────────────────────────────────────
# BACKGROUND AGENT TIMERS
# ─────────────────────────────────────────────────────────────────
AGENT_REPORTER_INTERVAL_MINUTES=5
AGENT_RESOLVER_INTERVAL_HOURS=6
AGENT_ANALYST_DAY_OF_WEEK=6
AGENT_ANALYST_HOUR=2
AGENT_VOLUNTEER_INTERVAL_HOURS=1
AGENT_MAX_RETRIES=3
AGENT_ESCALATION_DAYS=7
AGENT_AUTO_CLOSE_DAYS=7
AGENT_MIN_VOLUNTEER_MATCH_SCORE=0.6
SYSTEM_USER_ID=1

# ─────────────────────────────────────────────────────────────────
# FILE UPLOAD LIMITS
# ─────────────────────────────────────────────────────────────────
MAX_IMAGE_SIZE_MB=5
MAX_IMAGES_PER_ISSUE=5

# ═════════════════════════════════════════════════════════════════
# FREE TIER SERVICES MAP
# ═════════════════════════════════════════════════════════════════
# Backend API:    Render.com (Oregon Free Web Service)
# Static Frontend: Vercel CDN (Unlimited Bandwidth)
# PostgreSQL DB:   Neon.tech (0.5GB Serverless Postgres)
# Cloud Storage:   Cloudinary (25GB Media Tier)
# Email Delivery:  Resend.com (3,000 emails/mo)
# LLM AI:         Groq.com (LLaMA 3 8B, 100K tokens/day)
# Health Monitor:  UptimeRobot.com (5-minute HTTP Pings)
# ═════════════════════════════════════════════════════════════════
